{
  "name": "dsh-webdav",
  "version": "0.4.1",
  "description": "Universal WebDAV drives for DeepSeek Harness: agent tools (webdav_*), a multi-remote file browser panel and a settings page. Works with 123pan, Jianguoyun, Nextcloud, Synology, fnOS, ZSpace, Alist, Seafile and any RFC 4918 server. · 通用 WebDAV 网盘插件：给 Agent 提供 webdav_* 工具，并在 DSH 界面里提供多网盘文件浏览器与设置页。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "webdav",
    "webdav-client",
    "nas",
    "123pan",
    "123云盘",
    "jianguoyun",
    "坚果云",
    "nextcloud",
    "owncloud",
    "synology",
    "群晖",
    "fnos",
    "飞牛",
    "zspace",
    "极空间",
    "alist",
    "openlist",
    "seafile"
  ],
  "license": "MIT",
  "author": "Assuredfive",
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Assuredfive/dsh-webdav.git"
  },
  "homepage": "https://github.com/Assuredfive/dsh-webdav#readme",
  "bugs": {
    "url": "https://github.com/Assuredfive/dsh-webdav/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-better-sidebar"
      ],
      "external": []
    }
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "node --test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
